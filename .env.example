# Finnhub (free tier) — used ONLY by the nightly ingestion job
FINNHUB_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only: ingestion + privileged routes

# LLM for the NL → filter parse step (server-side only)
LLM_PROVIDER=groq                   # groq (default) or google — the whole swap
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile  # 8b-instant for more free headroom, 70b for better vague-query reads
# Only needed if LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# Ingestion behaviour
USE_CANDLES=true                    # set false if your Finnhub plan lacks /stock/candle
UNIVERSE_LIMIT=0                    # 0 = all tickers in data/universe.json; >0 caps for testing
